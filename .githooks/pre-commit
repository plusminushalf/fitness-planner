#!/usr/bin/env bash
# Blocks commits that would publish personal training data or account details.
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

bad_files=$(echo "$staged" | grep -iE '\.(csv|tsv|xlsx|numbers)$' | grep -vx 'sample-plans/sample-week.csv' || true)
if [ -n "$bad_files" ]; then
  echo "pre-commit: refusing to commit plan/export data:" >&2
  echo "$bad_files" | sed 's/^/  /' >&2
  exit 1
fi

if git diff --cached -U0 | grep -E '^\+' | grep -qiE 'DEVELOPMENT_TEAM *[:=] *[A-Z0-9]{10}|@gmail\.com'; then
  echo "pre-commit: staged changes contain a Team ID or personal email." >&2
  echo "Put DEVELOPMENT_TEAM in Config/Local.xcconfig (gitignored)." >&2
  exit 1
fi
