      "css": ".ds-set-table{font-family:-apple-system,system-ui,'SF Pro Text',sans-serif;background:#fff}.ds-row{display:grid;grid-template-columns:36px 1fr 70px 58px 44px;gap:8px;align-items:center;min-height:44px;padding:0 8px 0 12px;border-bottom:.5px solid rgba(60,60,67,.29);font-variant-numeric:tabular-nums}.ds-head{min-height:24px;border:none;font-size:11px;font-weight:600;letter-spacing:.6px;text-transform:uppercase;color:rgba(60,60,67,.6);text-align:center}.ds-head span:nth-child(2){text-align:left}.ds-row b{text-align:center;font-size:15px}.ds-warm{color:#FF9500}.ds-prev{font-size:15px;color:rgba(60,60,67,.6)}.ds-done{background:rgba(52,199,89,.16)}.ds-cell{box-sizing:border-box;width:100%;height:32px;border:none;border-radius:6px;background:rgba(118,118,128,.12);font:600 17px/32px -apple-system,system-ui,sans-serif;text-align:center;font-variant-numeric:tabular-nums}.ds-cell::placeholder{color:rgba(0,0,0,.6)}.ds-cell:focus-visible{outline:2px solid #1F6FEB}.ds-clear{background:transparent;display:block}.ds-check{justify-self:center;width:32px;height:32px;border:none;border-radius:6px;background:rgba(118,118,128,.12);color:rgba(60,60,67,.6);display:grid;place-items:center;cursor:pointer}.ds-check-on{background:#34C759;color:#fff}.ds-check:focus-visible{outline:2px solid #1F6FEB;outline-offset:2px}"
