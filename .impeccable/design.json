      "html": "<div class=\"ds-canvas\"><div class=\"ds-card\"><div class=\"ds-card-title\">Sunday workout</div><div class=\"ds-card-sub\">Today · Sample week</div><div class=\"ds-stats\"><div><div class=\"ds-stat-l\">Time</div><div class=\"ds-stat-v\">21min</div></div><div><div class=\"ds-stat-l\">Volume</div><div class=\"ds-stat-v\">320 kg</div></div><div><div class=\"ds-stat-l\">Sets</div><div class=\"ds-stat-v\">2 of 15</div></div></div></div></div>",
      "css": ".ds-canvas{background:#F2F2F7;padding:16px}.ds-card{font-family:-apple-system,system-ui,'SF Pro Text',sans-serif;background:#fff;border-radius:12px;padding:16px}.ds-card-title{font-size:20px;font-weight:700}.ds-card-sub{font-size:15px;color:rgba(60,60,67,.6);margin-top:2px}.ds-stats{display:grid;grid-template-columns:repeat(3,1fr);margin-top:12px}.ds-stat-l{font-size:12px;color:rgba(60,60,67,.6)}.ds-stat-v{font-size:15px;font-weight:600;font-variant-numeric:tabular-nums;margin-top:2px}"
    },
    {
      "name": "Set Table",
      "kind": "custom",
      "refersTo": "set-cell",
      "description": "Signature ledger: tracked uppercase headers, hairline rows, 32pt cells in 44pt rows, completed rows washed green.",
